<!doctype html>
<html lang="en">
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>__TITLE__ preview</title>
<style>body{margin:32px;background:#111418;color:#e5e7eb;font:14px system-ui;--primary-text-color:#e5e7eb;--secondary-text-color:#a0a8b3;--card-background-color:#1c2128;--divider-color:#343c47;--primary-color:#80bfff}main{max-width:640px;margin:auto}__CARD_TAG__{display:block;margin:16px 0}p{color:#a0a8b3}input{font:inherit;min-height:44px}</style>
<main><h1>__TITLE__</h1><p>Built card with simulated state. No Home Assistant connection.</p><__CARD_TAG__ id="compact"></__CARD_TAG__><__CARD_TAG__ id="wide"></__CARD_TAG__><label>Simulated state <input id="state" value="on"></label></main>
<script type="module">
await import('../dist/__CARD_TAG__.js');
const hass={states:{'__EXAMPLE_ENTITY__':{state:'on',attributes:{friendly_name:'Example device'}}}};
const cards=['compact','wide'].map(layout=>{const card=document.getElementById(layout);card.setConfig({entity:'__EXAMPLE_ENTITY__',layout});card.hass=hass;return card;});
document.getElementById('state').addEventListener('input',event=>{hass.states['__EXAMPLE_ENTITY__']={...hass.states['__EXAMPLE_ENTITY__'],state:event.target.value};cards.forEach(card=>card.hass=hass);});
</script>
</html>
